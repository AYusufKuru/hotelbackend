# Bu dosyayı backend/ içinde `.env` olarak kopyalayın ve değerleri doldurun.

# Merkez lisans sunucusu (admin/) — ikisi doluysa merkezden doğrulanır
LICENSE_SERVER_URL=http://127.0.0.1:9000
LICENSE_KEY=buraya-panelden-kopyaladiginiz-uuid
# 1 = URL veya key eksikse bile API kapalı (otel kurulumu için önerilir)
LICENSE_ENFORCE=1

# LAN / IP ile erişim (virgülle) — desktop başka PC’den API’ye girecekse bu makinenin IPv4’ü şart
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.102

# Kurulu masaüstü (Electron) başka bilgisayardan bağlanırken CORS (geliştirme/LAN testi)
DJANGO_CORS_ALLOW_ALL=1
# Alternatif: DJANGO_CORS_EXTRA_ORIGINS=http://127.0.0.1:5173 (Allow_all kapalıyken ek origin)
