# Bu dosyayı backend/ içinde `.env` olarak kopyalayın ve değerleri doldurun.

# Merkez lisans sunucusu (admin/) — ikisi doluysa merkezden doğrulanır
# Üretim (Vercel admin): https://hoteladmin-ruddy.vercel.app
# Yerel admin: http://127.0.0.1:9000
LICENSE_SERVER_URL=https://hoteladmin-ruddy.vercel.app
LICENSE_KEY=buraya-panelden-kopyaladiginiz-uuid
# 1 = URL veya key eksikse bile API kapalı (otel kurulumu için önerilir)
LICENSE_ENFORCE=1

# Host adları (virgülle) — Vercel backend dağıtımı: proje URL’si şart
# Örnek üretim: hotelbackend-eight.vercel.app — yerelde sadece 127.0.0.1,localhost yeter
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,hotelbackend-eight.vercel.app

# Vercel / üretim: PostgreSQL bağlantısı (Neon, Supabase, Vercel Postgres…).
# Hem Build hem Runtime ortamında tanımlı olmalı (migrate + ensure_bootstrap_user build’de çalışır).
# Yerel geliştirmede boş bırak → sqlite (db.sqlite3) kullanılır.
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# Masaüstü (Electron) / farklı origin: Allow_all genelde açık bırakılır
DJANGO_CORS_ALLOW_ALL=1
# Allow_all kapalıysa Vite ve gerekirse ek origin:
# DJANGO_CORS_EXTRA_ORIGINS=http://127.0.0.1:5173,https://hoteladmin-ruddy.vercel.app

# ─────────────────────────────────────────────────────────────────────
# Vercel ilk admin / API girişi (ensure_bootstrap_user — build sırasında çalışır)
#
# ÖNEMLİ: Bu değişkenleri Vercel’de hem ilgili ortama (Production/Preview) hem de
# “Build” aşamasına açık olarak tanımla. Sadece Runtime’da olurlarsa build’de boş
# kalır; kullanıcı oluşmaz → giriş “hatalı bilgi” döner.
#
# DJANGO_BOOTSTRAP_SUPERUSER=1
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=güçlü-bir-şifre
# İsteğe bağlı: DJANGO_SUPERUSER_EMAIL=admin@example.com
# Kullanıcı vardı, şifreyi sıfırlamak için bir deploy boyunca:
# DJANGO_SUPERUSER_RESET_PASSWORD=1
#
# Yerelde aynı komut: py -3 manage.py ensure_bootstrap_user

# ─────────────────────────────────────────────────────────────────────
# RAKİP OTEL FİYATLARI (opsiyonel) - Global Vision "Otomatik Bul"
# Booking/Trivago doğrudan scraping bot korumalarına takılır.
# Resmi yol: Amadeus Self-Service. Ücretsiz tier ayda 1000 istek.
# Kayıt: https://developers.amadeus.com/  → Self-Service Test API anahtarı al.
# Üretim için AMADEUS_BASE_URL=https://api.amadeus.com  yap.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# ─────────────────────────────────────────────────────────────────────
# ASİSTAN — sadece yerel/kurumi LLM (OpenAI vb. projede kullanılmaz)
#
# Önerilen: Ollama (https://ollama.com) — açık modeller kendi makinenizde çalışır
# Terminal: ollama pull llama3.2
AI_CHAT_API_BASE=http://127.0.0.1:11434/v1
AI_CHAT_MODEL=llama3.2
# Uzun CPU yanıtları (saniye): AI_CHAT_TIMEOUT_SECONDS=300
# Vekilde Bearer gerekirse: AI_CHAT_API_KEY=
